APP_NAME=AI powered Document Intelligence System
APP_VERSION=0.1.0
APP_SERVICE_NAME=api
APP_ENVIRONMENT=local
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_API_PREFIX=/api/v1
APP_MONGO_URI=mongodb://localhost:27017
APP_MONGO_DATABASE=document_intelligence
APP_OPENAI_API_KEY=
APP_OPENAI_MODEL=gpt-5.5
APP_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
APP_SEMANTIC_SEARCH_ENABLED=false
APP_GOOGLE_VISION_CREDENTIALS_FILE=Vision-api.text
APP_ALLOWED_ORIGINS=["http://localhost:3000"]
APP_DOCS_ENABLED=true
APP_ALLOWED_HOSTS=["localhost","127.0.0.1"]
APP_API_KEY=
APP_RATE_LIMIT_PER_MINUTE=120
APP_JOB_LEASE_SECONDS=120
APP_JOB_MAX_ATTEMPTS=3
APP_WORKER_POLL_SECONDS=1
# Optional Atlas vector index; leave empty for exact streaming cosine search.
APP_ATLAS_VECTOR_INDEX=
# Docker only. Use a randomly generated hex password (URI-safe).
MONGO_ROOT_USERNAME=document_admin
MONGO_ROOT_PASSWORD=
MONGO_APP_USERNAME=document_app
MONGO_APP_PASSWORD=
