APP_NAME=Production API
APP_VERSION=0.1.0
APP_SERVICE_NAME=api
APP_ENVIRONMENT=local
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_API_PREFIX=/api/v1
APP_MONGO_URI=mongodb://localhost:27017
APP_MONGO_DATABASE=document_intelligence
APP_OPENAI_API_KEY=
APP_OPENAI_MODEL=gpt-5.5
APP_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
APP_SEMANTIC_SEARCH_ENABLED=false
APP_GOOGLE_VISION_CREDENTIALS_FILE=Vision-api.text
APP_ALLOWED_ORIGINS=["http://localhost:3000"]
APP_DOCS_ENABLED=true
APP_ALLOWED_HOSTS=["localhost","127.0.0.1"]
